"""
Evaluate CNN -> SNN conversion on EchoNet-Dynamic.

Pipeline
--------
1. Load trained CNN checkpoint.
2. Evaluate original CNN.
3. Create a deep copy for SNN conversion.
4. Fold BatchNorm into convolution layers.
5. Optionally run Rate Normalization (RNL).
6. Replace ReLU with LIF neurons.
7. Evaluate SNN.
8. Report MAE, RMSE, R² and spike rates.

Important
---------
The CNN and SNN receive the same dataset tensor.

We intentionally DO NOT perform per-video min/max normalization
inside this evaluator because that changes the input distribution
between the original CNN and the converted SNN.
"""

import argparse
import copy
import os

import numpy as np
import torch
import torch.nn as nn
import tqdm

import echonet
from echonet.snn.conversion import (
    fold_batchnorm,
    convert_to_snn,
)
from echonet.snn.spiking_model import SpikingModel


# ============================================================
# Arguments
# ============================================================

parser = argparse.ArgumentParser(
    description="Evaluate CNN -> SNN conversion on EchoNet-Dynamic"
)

parser.add_argument(
    "--data_dir",
    required=True,
    help="Path to EchoNet-Dynamic dataset",
)

parser.add_argument(
    "--weights",
    required=True,
    help="Path to CNN checkpoint (.pt)",
)

parser.add_argument(
    "--device",
    default="cuda",
    help="cuda or cpu",
)

parser.add_argument(
    "--T",
    type=int,
    default=30,
    help="Number of SNN timesteps",
)

parser.add_argument(
    "--rnl_batches",
    type=int,
    default=20,
    help="Number of batches used for RNL calibration",
)

parser.add_argument(
    "--max_act_path",
    default=None,
    help="Optional path to saved max_activations.pth",
)

parser.add_argument(
    "--lif_threshold",
    type=float,
    default=0.5,
    help="LIF firing threshold",
)

parser.add_argument(
    "--lif_decay",
    type=float,
    default=0.9,
    help="LIF membrane decay",
)

parser.add_argument(
    "--max_samples",
    type=int,
    default=None,
    help=(
        "Maximum number of validation videos to evaluate. "
        "Use a small number such as 5 or 10 for testing."
    ),
)

parser.add_argument(
    "--batch_size",
    type=int,
    default=20,
    help="Validation batch size",
)

parser.add_argument(
    "--use_rnl",
    action="store_true",
    help="Enable conservative RNL weight scaling",
)

parser.add_argument(
    "--save_path",
    default="snn_eval_results.pth",
    help="Path for saved evaluation results",
)

args = parser.parse_args()


# ============================================================
# Device
# ============================================================

if args.device.startswith("cuda") and not torch.cuda.is_available():
    print("⚠️ CUDA requested but unavailable.")
    print("⚠️ Falling back to CPU.")
    device = torch.device("cpu")
else:
    device = torch.device(args.device)

print("=" * 70)
print("EchoNet CNN → SNN Evaluation")
print("=" * 70)

print(f"Device       : {device}")
print(f"Dataset      : {args.data_dir}")
print(f"Weights      : {args.weights}")
print(f"T            : {args.T}")
print(f"LIF threshold: {args.lif_threshold}")
print(f"LIF decay    : {args.lif_decay}")
print(f"RNL batches  : {args.rnl_batches}")
print(f"Use RNL      : {args.use_rnl}")
print(f"Max samples  : {args.max_samples}")
print("=" * 70)


# ============================================================
# Utility functions
# ============================================================

def unwrap_model(model):
    """
    Remove DataParallel / DistributedDataParallel wrapper.
    """

    if hasattr(model, "module"):
        print("⚡ Unwrapping DataParallel model")
        return model.module

    return model


def reset_snn(model):
    """
    Reset all stateful LIF neurons.
    """

    for module in model.modules():
        if hasattr(module, "reset"):
            module.reset()


def reset_snn_stats(model):
    """
    Reset spike statistics.
    """

    for module in model.modules():
        if hasattr(module, "reset_stats"):
            module.reset_stats()


def collect_spike_rates(model):
    """
    Collect spike rates from all LIF neurons.
    """

    rates = {}

    for name, module in model.named_modules():

        if hasattr(module, "get_spike_rate"):

            try:
                rates[name] = float(
                    module.get_spike_rate()
                )
            except Exception:
                pass

    return rates


def regression_metrics(pred, target):
    """
    Calculate MAE, RMSE and R².
    """

    pred = np.asarray(pred, dtype=np.float64)
    target = np.asarray(target, dtype=np.float64)

    error = pred - target

    mae = np.mean(np.abs(error))

    rmse = np.sqrt(
        np.mean(error ** 2)
    )

    ss_res = np.sum(
        (target - pred) ** 2
    )

    ss_tot = np.sum(
        (target - np.mean(target)) ** 2
    )

    if ss_tot == 0:
        r2 = float("nan")
    else:
        r2 = 1.0 - ss_res / ss_tot

    return mae, rmse, r2


def print_metrics(name, pred, target):
    """
    Print regression metrics.
    """

    mae, rmse, r2 = regression_metrics(
        pred,
        target,
    )

    print(
        f"  {name:<5} MAE : {mae:.4f}"
    )

    print(
        f"  {name:<5} RMSE: {rmse:.4f}"
    )

    print(
        f"  {name:<5} R²  : {r2:.4f}"
    )

    return {
        "mae": mae,
        "rmse": rmse,
        "r2": r2,
    }


# ============================================================
# Load checkpoint
# ============================================================

print()
print("=" * 70)
print("STEP 1 — Loading CNN")
print("=" * 70)

checkpoint = torch.load(
    args.weights,
    map_location=device,
)

print(
    f"Checkpoint type: {type(checkpoint)}"
)

if not isinstance(checkpoint, dict):
    raise RuntimeError(
        "Expected checkpoint to be a dictionary."
    )


print(
    "Checkpoint keys:",
    list(checkpoint.keys())
)


# ============================================================
# Load model
# ============================================================

# EchoNet's model architecture.
# The original trained model is R(2+1)D-18.

model = echonet.models.r2plus1d_18(
    pretrained=False,
    progress=False,
)

model = unwrap_model(model)


# ------------------------------------------------------------
# Locate state dictionary
# ------------------------------------------------------------

if "state_dict" in checkpoint:

    state_dict = checkpoint["state_dict"]

else:

    state_dict = checkpoint


# ------------------------------------------------------------
# Remove DataParallel prefix if present
# ------------------------------------------------------------

clean_state_dict = {}

for key, value in state_dict.items():

    if key.startswith("module."):
        key = key[len("module."):]

    clean_state_dict[key] = value


missing, unexpected = model.load_state_dict(
    clean_state_dict,
    strict=False,
)

if missing:
    print(
        "⚠️ Missing keys:",
        len(missing)
    )

if unexpected:
    print(
        "⚠️ Unexpected keys:",
        len(unexpected)
    )


model = model.to(device)
model.eval()

print("✅ CNN loaded")


# ============================================================
# Dataset
# ============================================================

print()
print("=" * 70)
print("Preparing EchoNet validation dataset")
print("=" * 70)

val_dataset = echonet.datasets.Echo(
    root=args.data_dir,
    split="val",
    target_type="EF",
    length=32,
    period=2,
)

print(
    f"Validation videos: {len(val_dataset)}"
)


# ============================================================
# Limit dataset for quick testing
# ============================================================

if args.max_samples is not None:

    if args.max_samples <= 0:
        raise ValueError(
            "--max_samples must be > 0"
        )

    actual_samples = min(
        args.max_samples,
        len(val_dataset),
    )

    val_dataset = torch.utils.data.Subset(
        val_dataset,
        range(actual_samples),
    )

    print(
        f"⚡ Limited evaluation to "
        f"{actual_samples} videos"
    )


val_loader = torch.utils.data.DataLoader(
    val_dataset,
    batch_size=args.batch_size,
    shuffle=False,
    num_workers=4,
    pin_memory=(device.type == "cuda"),
)


# ============================================================
# STEP 2 — CNN baseline
# ============================================================

print()
print("=" * 70)
print("STEP 2 — CNN Baseline Evaluation")
print("=" * 70)

cnn_preds = []
cnn_targets = []

with torch.no_grad():

    for X, y in tqdm.tqdm(
        val_loader,
        desc="CNN inference",
    ):

        X = X.to(
            device,
            non_blocking=True,
        )

        y = y.to(
            device,
            non_blocking=True,
        )

        output = model(X)

        output = output.reshape(-1)
        y = y.reshape(-1)

        cnn_preds.extend(
            output.detach()
            .cpu()
            .numpy()
            .tolist()
        )

        cnn_targets.extend(
            y.detach()
            .cpu()
            .numpy()
            .tolist()
        )


cnn_metrics = print_metrics(
    "CNN",
    cnn_preds,
    cnn_targets,
)


# ============================================================
# STEP 3 — Copy CNN for conversion
# ============================================================

print()
print("=" * 70)
print("STEP 3 — Preparing SNN copy")
print("=" * 70)

snn_cnn = copy.deepcopy(model)

snn_cnn = snn_cnn.to(device)

snn_cnn.eval()

print(
    "⚡ Creating deep copy of CNN for SNN conversion..."
)


# ============================================================
# STEP 4 — BatchNorm folding
# ============================================================

print()
print("⚡ Folding BatchNorm into Conv weights...")

snn_cnn = fold_batchnorm(
    snn_cnn
)

snn_cnn.eval()

remaining_bn = sum(
    1
    for module in snn_cnn.modules()
    if isinstance(
        module,
        (
            nn.BatchNorm1d,
            nn.BatchNorm2d,
            nn.BatchNorm3d,
        ),
    )
)

print(
    f"Remaining BatchNorm layers: "
    f"{remaining_bn}"
)


# ============================================================
# STEP 5 — RNL calibration
# ============================================================

max_activations = None

if args.use_rnl:

    print()
    print("=" * 70)
    print("STEP 5 — Rate Normalization")
    print("=" * 70)

    if args.max_act_path is not None:

        print(
            f"Loading activation statistics from:\n"
            f"{args.max_act_path}"
        )

        max_activations = torch.load(
            args.max_act_path,
            map_location="cpu",
        )

        print(
            f"✅ Loaded "
            f"{len(max_activations)} activation values"
        )

    else:

        print(
            f"⚡ Running RNL over "
            f"{args.rnl_batches} calibration batches..."
        )

        from echonet.snn.rnl import calibrate_model

        # Use the full validation loader for calibration,
        # but cap the number of batches.

        calibration_batches = []

        with torch.no_grad():

            for batch_idx, (X, _) in enumerate(
                val_loader
            ):

                if batch_idx >= args.rnl_batches:
                    break

                calibration_batches.append(
                    X.to(
                        device,
                        non_blocking=True,
                    )
                )

        print(
            f"Collected "
            f"{len(calibration_batches)} "
            f"calibration batches"
        )

        max_activations = calibrate_model(
            snn_cnn,
            calibration_batches,
        )

        print(
            f"✅ RNL collected "
            f"{len(max_activations)} layers"
        )

else:

    print()
    print("=" * 70)
    print("STEP 5 — RNL disabled")
    print("=" * 70)

    print(
        "⚠️ Weight scaling will NOT be applied."
    )


# ============================================================
# STEP 6 — CNN → SNN conversion
# ============================================================

print()
print("=" * 70)
print("STEP 6 — CNN → SNN Conversion")
print("=" * 70)

snn_cnn = convert_to_snn(
    snn_cnn,
    max_activations=max_activations,
    lif_threshold=args.lif_threshold,
    lif_decay=args.lif_decay,
    use_rnl=args.use_rnl,
)

snn_cnn.eval()


# ============================================================
# Count LIF neurons
# ============================================================

lif_count = 0

for module in snn_cnn.modules():

    if hasattr(module, "get_spike_rate"):
        lif_count += 1


print(
    f"   LIF neurons in model: {lif_count}"
)


# ============================================================
# STEP 7 — SpikingModel wrapper
# ============================================================

print()
print("=" * 70)
print("STEP 7 — Creating SpikingModel")
print("=" * 70)

snn_model = SpikingModel(
    snn_cnn,
    time_steps=args.T,
    input_min=0.0,
    input_max=1.0,
)

snn_model = snn_model.to(device)

snn_model.eval()

print(
    f"⚡ SNN ready "
    f"(T={args.T})"
)


# ============================================================
# IMPORTANT INPUT CHECK
# ============================================================

print()
print("=" * 70)
print("Input sanity check")
print("=" * 70)

sample_X, sample_y = val_dataset[0]

print(
    f"Input shape : {tuple(sample_X.shape)}"
)

print(
    f"Input min   : {sample_X.min().item():.6f}"
)

print(
    f"Input max   : {sample_X.max().item():.6f}"
)

print(
    f"Input mean  : {sample_X.mean().item():.6f}"
)

print(
    f"Ground truth: {float(sample_y):.6f}"
)

print()
print(
    "⚠️ NOTE: The input is NOT min-max normalized here."
)
print(
    "The SpikingModel expects [0,1], so this configuration"
)
print(
    "must be validated against the dataset normalization."
)


# ============================================================
# STEP 8 — SNN evaluation
# ============================================================

print()
print("=" * 70)
print("STEP 8 — SNN Evaluation")
print("=" * 70)

snn_preds = []
snn_targets = []

reset_snn(snn_model)
reset_snn_stats(snn_model)

with torch.no_grad():

    for X, y in tqdm.tqdm(
        val_loader,
        desc=f"SNN inference (T={args.T})",
    ):

        X = X.to(
            device,
            non_blocking=True,
        )

        y = y.to(
            device,
            non_blocking=True,
        )

        # ----------------------------------------------------
        # Reset state before every batch.
        # ----------------------------------------------------

        reset_snn(snn_model)

        output = snn_model(X)

        output = output.reshape(-1)
        y = y.reshape(-1)

        snn_preds.extend(
            output.detach()
            .cpu()
            .numpy()
            .tolist()
        )

        snn_targets.extend(
            y.detach()
            .cpu()
            .numpy()
            .tolist()
        )


# ============================================================
# SNN metrics
# ============================================================

print()
print("=" * 70)
print("RESULTS")
print("=" * 70)

snn_metrics = print_metrics(
    "SNN",
    snn_preds,
    snn_targets,
)


# ============================================================
# Compare CNN and SNN
# ============================================================

print()
print(
    f"{'Metric':<12}"
    f"{'CNN':>12}"
    f"{'SNN':>12}"
    f"{'Δ':>12}"
)

print("-" * 48)

for metric in [
    "mae",
    "rmse",
    "r2",
]:

    cnn_value = cnn_metrics[metric]
    snn_value = snn_metrics[metric]

    delta = snn_value - cnn_value

    print(
        f"{metric.upper():<12}"
        f"{cnn_value:>12.4f}"
        f"{snn_value:>12.4f}"
        f"{delta:>12.4f}"
    )


# ============================================================
# Spike statistics
# ============================================================

print()
print("=" * 70)
print("SPIKE STATISTICS")
print("=" * 70)

spike_rates = collect_spike_rates(
    snn_model
)

if spike_rates:

    values = list(
        spike_rates.values()
    )

    avg_spike_rate = float(
        np.mean(values)
    )

    print(
        f"Average spike rate: "
        f"{avg_spike_rate:.6f}"
    )

    print(
        f"LIF layers: "
        f"{len(values)}"
    )

    dead_layers = [
        (name, rate)
        for name, rate in spike_rates.items()
        if rate < 0.01
    ]

    saturated_layers = [
        (name, rate)
        for name, rate in spike_rates.items()
        if rate > 0.80
    ]

    print(
        f"Dead layers (<1%): "
        f"{len(dead_layers)}/{len(values)}"
    )

    print(
        f"Saturated layers (>80%): "
        f"{len(saturated_layers)}/{len(values)}"
    )

    print()
    print("Per-layer spike rates:")

    for name, rate in spike_rates.items():

        marker = "🟢" if rate >= 0.05 else "🔴"

        bars = int(
            min(rate * 20, 20)
        )

        print(
            f"  {marker} "
            f"{name:<45} "
            f"{rate:.4f} "
            f"{'█' * bars}"
        )

else:

    avg_spike_rate = None

    dead_layers = []

    saturated_layers = []

    print(
        "⚠️ No spike statistics were collected."
    )


# ============================================================
# Prediction sanity check
# ============================================================

print()
print("=" * 70)
print("PREDICTION SANITY CHECK")
print("=" * 70)

cnn_preds_np = np.asarray(
    cnn_preds
)

snn_preds_np = np.asarray(
    snn_preds
)

targets_np = np.asarray(
    cnn_targets
)

print(
    f"Ground truth:"
)

print(
    f"  min  = {targets_np.min():.4f}"
)

print(
    f"  mean = {targets_np.mean():.4f}"
)

print(
    f"  max  = {targets_np.max():.4f}"
)

print()
print(
    f"CNN prediction:"
)

print(
    f"  min  = {cnn_preds_np.min():.4f}"
)

print(
    f"  mean = {cnn_preds_np.mean():.4f}"
)

print(
    f"  max  = {cnn_preds_np.max():.4f}"
)

print()
print(
    f"SNN prediction:"
)

print(
    f"  min  = {snn_preds_np.min():.4f}"
)

print(
    f"  mean = {snn_preds_np.mean():.4f}"
)

print(
    f"  max  = {snn_preds_np.max():.4f}"
)


# ============================================================
# First few predictions
# ============================================================

print()
print("First predictions:")

for i in range(
    min(10, len(snn_preds))
):

    print(
        f"  {i:03d} "
        f"GT={targets_np[i]:8.3f} "
        f"CNN={cnn_preds_np[i]:8.3f} "
        f"SNN={snn_preds_np[i]:8.3f}"
    )


# ============================================================
# Warning
# ============================================================

if snn_metrics["r2"] < 0:

    print()
    print(
        "⚠️ WARNING:"
    )

    print(
        "SNN R² is negative."
    )

    print(
        "This means the current SNN is worse than"
    )

    print(
        "a simple mean-value baseline."
    )

    print()
    print(
        "Do NOT immediately increase T."
    )

    print(
        "First inspect input encoding, output scaling,"
    )

    print(
        "and dead LIF layers."
    )


# ============================================================
# Save results
# ============================================================

results = {
    "cnn": {
        "predictions": np.asarray(
            cnn_preds
        ),
        "targets": np.asarray(
            cnn_targets
        ),
        "mae": cnn_metrics["mae"],
        "rmse": cnn_metrics["rmse"],
        "r2": cnn_metrics["r2"],
    },

    "snn": {
        "predictions": np.asarray(
            snn_preds
        ),
        "targets": np.asarray(
            snn_targets
        ),
        "mae": snn_metrics["mae"],
        "rmse": snn_metrics["rmse"],
        "r2": snn_metrics["r2"],
    },

    "settings": {
        "T": args.T,
        "lif_threshold": args.lif_threshold,
        "lif_decay": args.lif_decay,
        "rnl_batches": args.rnl_batches,
        "use_rnl": args.use_rnl,
        "max_samples": args.max_samples,
    },

    "spike_rates": spike_rates,

    "avg_spike_rate": avg_spike_rate,

    "dead_layers": dead_layers,

    "saturated_layers": saturated_layers,
}


torch.save(
    results,
    args.save_path,
)

print()
print(
    f"💾 Results saved to:"
)
print(
    f"   {os.path.abspath(args.save_path)}"
)

print()
print("=" * 70)
print("✅ Evaluation complete")
print("=" * 70)

